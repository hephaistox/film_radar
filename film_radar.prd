// FilmRadar — PRD v0.2 (2026-11-14 ; premier jet le 2026-11-09)
// Dépôt : film_radar. Nom produit choisi pour fonctionner en français et en anglais.

product "FilmRadar" {

  vision "FilmRadar garde un œil sur la télévision à votre place : vous signalez les films
          que vous aimez, ceux que vous voulez voir, et vous êtes prévenu dès qu'un
          de vos films est programmé sur une chaîne que vous recevez.
          Là où les guides TV ne montrent que la grille de la semaine, FilmRadar
          veille sur vos films dans la durée, et vous indique où les regarder :
          à la télé, sur vos plateformes ou en location."

  problem {
    situation "L'offre de films accessible à un spectateur moyen est déjà énorme : de nombreuses
               chaînes de télévision (TNT, câble, satellite), des plateformes gratuites
               (replay, services financés par la publicité) et les plateformes auxquelles il est
               déjà abonné. Les films continuent notamment d'être largement diffusés à la
               télévision, souvent gratuitement, mais leur programmation n'est connue que
               quelques jours ou semaines à l'avance."
    complication "Le manque n'est pas l'offre mais le lien entre une envie et le moment où le film
                  devient accessible. Quand on repère un film qui n'est disponible nulle part sur
                  l'instant, l'envie se perd faute de suivi ; et devant la grille des programmes
                  ou l'écran de recherche d'une plateforme, on ne sait plus ce qu'on cherchait.
                  Pour voir un film précis à la télé, il faut éplucher régulièrement les
                  programmes ou tomber dessus par hasard. Les guides TV n'alertent que sur
                  un programme déjà présent dans la grille, et les outils de watchlist
                  (JustWatch, AlertFilm…) ne suivent que le streaming et les sorties.
                  Résultat : on rate la diffusion, ou on paie un abonnement ou une location
                  pour un film qui passait gratuitement la semaine suivante."
    question "Comment ne plus perdre ses envies de films et les retrouver au moment où ils deviennent
              regardables, à la télé ou ailleurs, sans surveiller soi-même les programmes et les catalogues ?"
  }

  scope {
    "Inclus : chaînes de télévision linéaires reçues en France (TNT en priorité)"
    "Inclus : films de long métrage (pas les séries ni les émissions)"
    "Exclu des R1 et R2 : replay, streaming, vidéo à la demande"
    "Inclus à partir de la R3 : plateformes de streaming, plateformes gratuites, VOD payante"
  }

  non-goals {
    "Diffuser ou héberger des films — FilmRadar prévient, il ne diffuse pas"
    "Remplacer un guide TV complet — on ne montre que ce qui concerne vos films"
    "Devenir un réseau social de critiques (notes, avis publics, fil d'actualité) — SensCritique et Letterboxd le font déjà"
  }

  // ---------------------------------------------------------------------------
  // Preuves
  // ---------------------------------------------------------------------------

  evidence "Aucun concurrent sur l'alerte de diffusion TV en France" {
    type market-research
    summary "Une recherche rapide sur les stores et le web ne trouve aucune application
             française qui surveille dans la durée la programmation TV d'un film choisi.
             Télé-Loisirs n'alerte que sur un programme déjà dans la grille (2 à 60 min avant) ;
             TV Guide (US) le fait pour sa watchlist mais seulement aux États-Unis ;
             JustWatch, Flickoon, AlertFilm et TMDB Notifier couvrent le streaming ;
             Watchlistr, Switch TV ON et TodoMovies couvrent les sorties."
    source-reference "Recherche web et App Store du 2026-11-09 (Claude Code), non exhaustive"
    date 2026-11-09
    confidence weak
    supports "FEAT-003"
  }

  evidence "Des envies de films perdues faute de disponibilité immédiate" {
    type user-research
    summary "Observation personnelle du porteur du produit et de son entourage : on repère
             régulièrement un film (conseil, article, bande-annonce) sans savoir où le regarder
             sur l'instant. Comme il n'est pas disponible tout de suite et qu'on ne le recherche
             pas régulièrement ensuite, on en perd la trace et l'envie disparaît.
             Plus tard, devant la grille des programmes ou l'écran de recherche d'une plateforme,
             on ne sait plus ce qu'on cherchait."
    source-reference "Observation informelle du porteur du produit et de son entourage, non quantifiée"
    date 2026-11-13
    confidence weak
    supports "FEAT-002"
  }

  // ---------------------------------------------------------------------------
  // Personas
  // ---------------------------------------------------------------------------

  persona "Cinéphile du petit écran" {
    role "Amateur de cinéma qui regarde régulièrement des films à la télévision
          et tient une liste (mentale ou écrite) de films à voir ou à revoir"
    goals {
      "Voir les films qui l'intéressent quand ils passent gratuitement"
      "Revoir ses films préférés au bon moment"
      "Ne plus avoir à surveiller les programmes TV"
    }
    frustrations {
      "Découvrir après coup qu'un film attendu est passé la veille"
      "Devoir consulter les programmes chaque semaine pour rien"
      "Payer une location pour un film diffusé gratuitement peu après"
    }
    context "Possède une TV avec la TNT et souvent une box, qui inclut en général un service de VOD ;
             est abonné à 2 ou 3 plateformes (par exemple Netflix, et Prime Video obtenu avec
             l'abonnement Amazon Prime) ; consulte son smartphone au quotidien ;
             regarde des films surtout en soirée et le week-end"
    weight primary
  }

  persona "Spectateur de passage" {
    role "Personne qui a entendu parler d'un film (conseil d'un proche, article)
          et aimerait le voir un jour, sans en faire une démarche active"
    goals {
      "Ne pas oublier ce film"
      "Le voir sans effort ni frais si l'occasion se présente"
    }
    frustrations {
      "Oublie le titre du film au bout de quelques semaines"
      "N'a pas envie d'installer plusieurs applications pour un seul film"
    }
    context "Usage ponctuel ; ajoute un ou deux films puis n'ouvre l'application
             que lorsqu'il reçoit une alerte"
    weight secondary
  }

  persona "Spectateur 100 % streaming" {
    role "Personne qui ne regarde plus la télévision linéaire"
    goals {
      "Savoir sur quelle plateforme un film est disponible"
    }
    frustrations {
      "Les alertes de diffusion TV ne lui servent à rien"
    }
    context "Pas de TV ou TV utilisée uniquement avec des applications de streaming.
             Non servi par les R1 et R2 ; servi à partir de la R3 (radar streaming, « Où regarder »)"
    weight secondary
  }

  // ---------------------------------------------------------------------------
  // Jobs
  // ---------------------------------------------------------------------------

  job "Ne pas rater la diffusion d'un film attendu" {
    persona "Cinéphile du petit écran"
    statement "Quand un film que je veux voir ou revoir finit par être programmé à la télé,
               je veux le savoir suffisamment tôt,
               pour pouvoir m'organiser et le regarder ou l'enregistrer."
    type functional
    importance critical
    satisfaction unserved
    related-to "Garder la trace des films qui m'intéressent"
    desired-outcomes {
      "Minimiser le risque qu'un film suivi passe à la télé sans que je sois prévenu" {
        importance high
        current-satisfaction low
      }
      "Maximiser le délai entre l'alerte et la diffusion" {
        importance high
        current-satisfaction low
      }
      "Minimiser le temps passé à consulter les programmes TV" {
        importance medium
        current-satisfaction low
      }
      "Minimiser le nombre d'alertes inutiles (chaîne non reçue, mauvais film)" {
        importance high
        current-satisfaction medium
      }
    }
  }

  job "Garder la trace des films qui m'intéressent" {
    persona "Cinéphile du petit écran"
    statement "Quand j'entends parler d'un film ou que je repense à un film que j'ai aimé,
               je veux le noter en quelques secondes,
               pour ne pas l'oublier et pouvoir y revenir."
    type functional
    importance important
    satisfaction underserved
    desired-outcomes {
      "Minimiser le temps pour retrouver et noter un film" {
        importance high
        current-satisfaction medium
      }
      "Minimiser le risque de confondre deux films au titre proche" {
        importance medium
        current-satisfaction medium
      }
      "Minimiser le temps pour retrouver un film dont on a oublié le titre
       mais dont on se rappelle le réalisateur, un acteur ou le style" {
        importance high
        current-satisfaction low
      }
    }
  }

  job "Ne pas regretter d'avoir payé un film gratuit" {
    persona "Spectateur de passage"
    statement "Quand j'ai envie de voir un film mais qu'il n'est pas urgent,
               je veux attendre qu'il passe gratuitement à la télé,
               pour ne pas payer une location ou un abonnement pour rien."
    type emotional
    importance important
    satisfaction underserved
    desired-outcomes {
      "Minimiser l'effort pour suivre un film sans y penser" {
        importance high
        current-satisfaction low
      }
    }
  }

  job "Savoir quoi regarder parmi mes envies, maintenant" {
    persona "Cinéphile du petit écran"
    statement "Quand je m'installe pour regarder un film et que je ne sais pas quoi choisir,
               je veux retrouver mes envies de films qui sont regardables maintenant ou bientôt,
               pour profiter de l'offre que j'ai déjà au lieu de chercher au hasard."
    type functional
    importance important
    satisfaction unserved
    related-to "Garder la trace des films qui m'intéressent"
    desired-outcomes {
      "Minimiser le temps entre « je veux regarder un film » et le choix d'un film" {
        importance high
        current-satisfaction low
      }
      "Maximiser la part des films choisis qui viennent de mes envies notées" {
        importance medium
        current-satisfaction low
      }
      "Minimiser le coût pour regarder un film déjà disponible gratuitement ou dans mes abonnements" {
        importance high
        current-satisfaction low
      }
    }
  }

  job "Être prévenu des films qui correspondent à mes goûts" {
    persona "Cinéphile du petit écran"
    statement "Quand je suis un cinéaste, un acteur ou un genre que j'aime,
               je veux être prévenu dès qu'un de leurs films est programmé,
               sans avoir à connaître et ajouter chaque titre à l'avance."
    type functional
    importance important
    satisfaction unserved
    related-to "Ne pas rater la diffusion d'un film attendu"
    desired-outcomes {
      "Minimiser le risque qu'un film d'un cinéaste ou d'un genre suivi passe sans que je sois prévenu" {
        importance high
        current-satisfaction low
      }
      "Minimiser le nombre d'alertes hors sujet" {
        importance medium
        current-satisfaction low
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Objectifs
  // ---------------------------------------------------------------------------

  goal "Fiabilité du radar" {
    statement "Prévenir l'utilisateur de presque toutes les diffusions de ses films suivis
               sur les chaînes couvertes, avec un délai suffisant pour s'organiser."
    horizon short-term
    owner "Anthony (porteur du produit)"
    metric {
      indicator "Part des diffusions de films suivis (chaînes couvertes) ayant donné lieu à une alerte"
      target "≥ 95 %"
      measurement "Audit mensuel : comparaison des programmes publiés et des alertes envoyées"
    }
    metric {
      indicator "Délai médian entre l'alerte et la diffusion"
      target "≥ 3 jours (cible indicative, à confirmer par la pratique)"
      measurement "Horodatage des alertes comparé à l'heure de diffusion"
    }
  }

  goal "Pertinence des alertes" {
    statement "Les alertes reçues concernent le bon film, sur une chaîne que l'utilisateur reçoit."
    horizon short-term
    owner "Anthony (porteur du produit)"
    metric {
      indicator "Part des alertes signalées comme erronées par les utilisateurs"
      target "< 2 %"
      measurement "Bouton « ce n'est pas le bon film » dans l'alerte"
    }
  }

  goal "Adoption et rétention" {
    statement "Les utilisateurs suivent plusieurs films et restent abonnés aux alertes dans la durée."
    horizon mid-term
    owner "Anthony (porteur du produit)"
    metric {
      indicator "Nombre médian de films « envie de voir » (donc sous radar) par utilisateur actif"
      target "≥ 5"
      measurement "Statistiques produit"
    }
    metric {
      indicator "Part des utilisateurs ayant encore les alertes actives 3 mois après inscription"
      target "≥ 40 %"
      measurement "Cohortes mensuelles"
    }
  }

  goal "Trafic qualifié vers les plateformes" {
    statement "FilmRadar devient un point de départ pour regarder un film : une part significative
               des films choisis par les utilisateurs mène à un clic vers la plateforme de streaming
               ou de VOD où le regarder. Condition préalable à toute monétisation."
    horizon mid-term
    owner "Anthony (porteur du produit)"
    metric {
      indicator "Nombre mensuel de redirections vers une plateforme de streaming ou de VOD"
      target "À définir après la R2, une fois la base d'utilisateurs connue"
      measurement "Comptage des clics sortants par plateforme"
    }
  }

  goal "Monétisation par les plateformes" {
    statement "Les plateformes de streaming et de VOD rémunèrent FilmRadar pour le trafic qualifié
               qu'il leur apporte et pour la mise en avant de leur offre quand un film
               est disponible à plusieurs endroits."
    horizon long-term
    owner "Anthony (porteur du produit)"
    metric {
      indicator "Nombre de plateformes partenaires rémunérant le trafic"
      target "≥ 1 plateforme partenaire"
      baseline "0 (aucun contact engagé)"
      measurement "Contrats signés"
    }
  }

  // ---------------------------------------------------------------------------
  // Hypothèses
  // ---------------------------------------------------------------------------

  hypothesis "L'alerte de diffusion crée la rétention" {
    intervention "Alerter l'utilisateur quand un film qu'il suit est programmé à la télé"
    expected-outcome "Au moins 40 % des utilisateurs gardent les alertes actives après 3 mois"
    mechanism "Chaque alerte est un moment de valeur concret (un film voulu, gratuit, bientôt)
               qui rappelle l'utilité de l'application sans demander d'effort"
    validation-method "Bêta fermée avec 30 à 50 utilisateurs pendant 3 mois, suivi par cohorte"
    status proposed
    proposes "FEAT-003"
    predicts "Adoption et rétention"
  }

  hypothesis "Filtrer par chaînes reçues réduit les alertes inutiles" {
    intervention "Laisser l'utilisateur indiquer les chaînes qu'il reçoit"
    expected-outcome "Moins de 2 % d'alertes signalées comme erronées"
    mechanism "Une alerte pour une chaîne non reçue est perçue comme du bruit et pousse à couper les notifications"
    validation-method "Comparer le taux de désactivation des alertes avant et après la fonctionnalité"
    status proposed
    proposes "FEAT-004"
    predicts "Pertinence des alertes"
  }

  hypothesis "Les plateformes paieront pour un trafic à forte intention" {
    intervention "Montrer pour chaque film où le regarder (télé, streaming, VOD payante) avec un lien direct,
                  et départager les offres de même coût pour l'utilisateur en faveur d'une plateforme partenaire"
    expected-outcome "Au moins une plateforme accepte de rémunérer le trafic ou la mise en avant"
    mechanism "Un utilisateur qui arrive avec un film précis en tête est prêt à regarder :
               ce trafic vaut plus pour une plateforme qu'une visite de découverte"
    validation-method "Mesurer pendant 6 mois les redirections par plateforme, puis présenter
                       ces chiffres à 3 plateformes pour obtenir une proposition commerciale"
    status proposed
    proposes "FEAT-012"
    predicts "Monétisation par les plateformes"
  }

  // ---------------------------------------------------------------------------
  // Fonctionnalités
  // ---------------------------------------------------------------------------

  feature FEAT-001 "Recherche de film" {
    summary "Retrouver un film par son titre (français ou original), avec affiche, année et réalisateur pour lever les ambiguïtés"
    persona "Cinéphile du petit écran"
    value-proposition "Noter un film en quelques secondes sans se tromper de version ou de remake"
    priority must
    status proposed
    addresses "Garder la trace des films qui m'intéressent"
    advances "Pertinence des alertes"
    non-goals {
      "Afficher des critiques ou des notes publiques"
    }
    stories {
      US-001 "En tant que cinéphile du petit écran, je veux chercher un film par son titre français
              ou original, afin de le retrouver même si je ne connais qu'un des deux titres." {
        acceptance-criteria {
          AC-001-01 "La recherche trouve un film par son titre français comme par son titre original"
          AC-001-02 "Chaque résultat affiche l'affiche, l'année de sortie et le réalisateur"
          AC-001-03 "Deux films de même titre (remake, homonyme) apparaissent comme deux résultats distincts"
        }
      }
    }
  }

  feature FEAT-013 "Compte : connexion sans mot de passe" {
    summary "Créer un compte et se connecter avec un lien envoyé par e-mail ou avec son compte Google,
             sans jamais créer de mot de passe"
    persona "Cinéphile du petit écran"
    value-proposition "Retrouver ses envies sur tous ses appareils et recevoir ses alertes,
                       sans mot de passe à inventer ni à retenir"
    priority must
    status proposed
    addresses "Garder la trace des films qui m'intéressent", "Ne pas rater la diffusion d'un film attendu"
    advances "Adoption et rétention"
    non-goals {
      "Gérer des mots de passe (création, oubli, réinitialisation)"
      "Proposer d'autres fournisseurs d'identité que Google en R1 (Apple, Facebook…)"
      "Partager un compte entre plusieurs personnes d'un même foyer"
    }
    stories {
      US-011 "En tant que cinéphile du petit écran, je veux me connecter avec un lien reçu par e-mail,
              afin de ne pas avoir de mot de passe à créer ni à retenir." {
        acceptance-criteria {
          AC-011-01 "Je saisis mon adresse e-mail et je reçois un lien de connexion"
          AC-011-02 "Le lien n'est utilisable qu'une fois et expire au bout de 15 minutes"
          AC-011-03 "Le premier clic sur le lien crée mon compte et prouve que j'ai accès à cette boîte ;
                     les suivants me connectent à ce même compte"
          AC-011-04 "Aucun mot de passe ne m'est jamais demandé"
          AC-011-05 "Si le lien a expiré, l'application me propose d'en recevoir un nouveau"
        }
      }
      US-012 "En tant que cinéphile du petit écran, je veux me connecter avec mon compte Google,
              afin de m'inscrire en un geste." {
        acceptance-criteria {
          AC-012-01 "Je peux créer mon compte ou me connecter avec Google sans saisir mon adresse e-mail"
          AC-012-02 "Si mon adresse Google est celle d'un compte déjà créé par lien e-mail, je retrouve ce compte"
          AC-012-03 "FilmRadar ne demande à Google que mon adresse e-mail et mon nom"
        }
      }
      US-013 "En tant que cinéphile du petit écran, je veux rester connecté sur mon appareil,
              afin de ne pas devoir me reconnecter à chaque alerte." {
        acceptance-criteria {
          AC-013-01 "Je reste connecté sur un appareil pendant au moins 90 jours sans me reconnecter"
          AC-013-02 "Je peux me déconnecter d'un appareil à tout moment"
        }
      }
      US-014 "En tant que cinéphile du petit écran, je veux supprimer mon compte,
              afin que FilmRadar ne garde plus mes données." {
        acceptance-criteria {
          AC-014-01 "Je peux demander la suppression de mon compte depuis l'application"
          AC-014-02 "Mes données personnelles sont effacées dans un délai de 30 jours"
        }
      }
    }
  }

  feature FEAT-010 "Recherche par réalisateur, acteur et genre" {
    summary "Retrouver un film sans connaître son titre, à partir de ce dont on se souvient :
             réalisateur, acteurs, genre (tel que fourni par le catalogue de films), époque"
    persona "Cinéphile du petit écran"
    value-proposition "Retrouver « le film de Lynch avec Naomi Watts » ou « ce polar des années 2000 »
                       même quand le titre est oublié — c'est aussi la première frustration
                       du spectateur de passage"
    priority should
    status proposed
    addresses "Garder la trace des films qui m'intéressent"
    advances "Adoption et rétention"
    non-goals {
      "Reconnaître un film à partir d'une image, d'un extrait ou d'une musique"
      "Suivre un réalisateur, un acteur ou un genre dans la durée — c'est le rôle de FEAT-008"
      "Rechercher par style ou sous-genre fin (ambiance, « gore »…) — c'est le rôle de FEAT-011"
    }
    stories {
      US-008 "En tant que cinéphile du petit écran, je veux chercher un film par son réalisateur
              ou ses acteurs, afin de le retrouver même si j'ai oublié son titre." {
        acceptance-criteria {
          AC-008-01 "La recherche par nom de réalisateur ou d'acteur liste ses films, du plus récent au plus ancien"
          AC-008-02 "Un nom mal orthographié ou incomplet propose les personnes les plus proches"
          AC-008-03 "Chaque résultat affiche l'affiche, l'année de sortie et le réalisateur, comme la recherche par titre"
        }
      }
      US-009 "En tant que cinéphile du petit écran, je veux combiner plusieurs souvenirs
              (une personne, un genre, une époque), afin de réduire la liste à quelques films." {
        acceptance-criteria {
          AC-009-01 "Je peux combiner une personne, un genre du catalogue et une période"
          AC-009-02 "Chaque critère ajouté réduit la liste des résultats"
          AC-009-03 "Depuis un résultat, je peux marquer le film « j'aime » ou « envie de voir », comme depuis la recherche par titre"
        }
      }
    }
  }

  feature FEAT-011 "Recherche par style" {
    summary "Retrouver un film par son style ou un sous-genre fin (ambiance, « gore », « film noir »…),
             à partir des données de style réellement disponibles"
    persona "Cinéphile du petit écran"
    value-proposition "Retrouver un film dont on ne se rappelle que l'atmosphère"
    priority could
    status proposed
    addresses "Garder la trace des films qui m'intéressent"
    advances "Adoption et rétention"
    non-goals {
      "Créer ou maintenir soi-même une classification des styles — on s'appuie sur les données trouvées"
    }
  }

  feature FEAT-012 "Où regarder : télé, streaming et VOD payante" {
    summary "Pour chaque film, montrer toutes les façons de le regarder — diffusion télé, plateformes gratuites,
             plateformes auxquelles je suis abonné, location ou achat en VOD — avec un lien direct"
    persona "Cinéphile du petit écran"
    value-proposition "Passer de « j'ai envie de ce film » à « je le regarde » en un clic,
                       par le moyen le moins cher pour moi"
    priority should
    status accepted
    addresses "Savoir quoi regarder parmi mes envies, maintenant", "Ne pas regretter d'avoir payé un film gratuit"
    advances "Trafic qualifié vers les plateformes", "Monétisation par les plateformes"
    tested-by "Les plateformes paieront pour un trafic à forte intention"
    non-goals {
      "Mettre en avant une offre payante quand le film est accessible gratuitement ou dans un abonnement de l'utilisateur —
       la mise en avant rémunérée ne départage que des offres de même coût pour lui"
      "Vendre ou louer des films nous-mêmes — on redirige vers la plateforme"
    }
  }

  feature FEAT-002 "Mes films : j'aime / envie de voir" {
    summary "Marquer un film comme aimé et/ou comme envie de voir, et retrouver ces listes"
    persona "Cinéphile du petit écran"
    value-proposition "Un seul endroit pour garder ses films ; chaque envie de voir est automatiquement sous radar"
    priority must
    status proposed
    addresses "Garder la trace des films qui m'intéressent"
    advances "Adoption et rétention"
    non-goals {
      "Noter les films sur une échelle (étoiles, note sur 10)"
      "Partager ses listes publiquement"
    }
    stories {
      US-002 "En tant que cinéphile du petit écran, je veux indiquer que j'aime un film,
              afin de garder la trace de mes films préférés." {
        acceptance-criteria {
          AC-002-01 "Je peux marquer et démarquer un film comme aimé"
          AC-002-02 "Je retrouve la liste de mes films aimés"
        }
      }
      US-003 "En tant que cinéphile du petit écran, je veux indiquer que j'ai envie de voir un film,
              afin de ne pas l'oublier." {
        acceptance-criteria {
          AC-003-01 "Je peux marquer et démarquer un film comme envie de voir"
          AC-003-02 "Un même film peut être à la fois aimé et envie de voir (pour le revoir)"
          AC-003-03 "Marquer un film comme envie de voir le met sous radar, sans autre action"
        }
      }
    }
  }

  feature FEAT-003 "Radar de diffusion" {
    summary "Chaque film marqué « envie de voir » est sous radar : une alerte est envoyée dès qu'il est
             programmé sur une chaîne couverte"
    persona "Cinéphile du petit écran"
    value-proposition "Ne plus jamais rater un film attendu, sans surveiller les programmes"
    priority must
    status proposed
    addresses "Ne pas rater la diffusion d'un film attendu", "Ne pas regretter d'avoir payé un film gratuit"
    advances "Fiabilité du radar", "Adoption et rétention"
    tested-by "L'alerte de diffusion crée la rétention"
    non-goals {
      "Alerter sur les séries ou les émissions"
    }
    stories {
      US-004 "En tant que cinéphile du petit écran, je veux que chaque film que j'ai envie de voir
              soit sous radar, afin d'être prévenu quand il passera à la télé sans geste supplémentaire." {
        acceptance-criteria {
          AC-004-01 "Un film est sous radar si et seulement s'il est marqué « envie de voir »"
          AC-004-02 "Retirer la mention « envie de voir » retire le film du radar"
          AC-004-03 "Le radar reste actif sans limite de durée tant que la mention « envie de voir » est présente"
          AC-004-04 "Pour revoir un film aimé, je le marque aussi « envie de voir », ce qui le met sous radar"
        }
      }
      US-005 "En tant que cinéphile du petit écran, je veux recevoir une alerte dès qu'un film
              sous radar est programmé, afin de pouvoir m'organiser." {
        acceptance-criteria {
          AC-005-01 "L'alerte est envoyée dès que la diffusion apparaît dans les programmes connus"
          AC-005-02 "L'alerte indique le film, la chaîne, la date et l'heure de diffusion"
          AC-005-03 "Un rappel est envoyé le jour de la diffusion"
          AC-005-04 "Une même diffusion ne déclenche qu'une alerte (plus le rappel)"
          AC-005-05 "Si la diffusion est déprogrammée ou déplacée, je suis prévenu"
        }
      }
    }
  }

  feature FEAT-004 "Mes chaînes" {
    summary "Indiquer les chaînes que je reçois pour ne recevoir que des alertes utiles"
    persona "Cinéphile du petit écran"
    value-proposition "Pas d'alerte pour un film diffusé sur une chaîne que je ne peux pas regarder"
    priority should
    status proposed
    addresses "Ne pas rater la diffusion d'un film attendu"
    advances "Pertinence des alertes"
    tested-by "Filtrer par chaînes reçues réduit les alertes inutiles"
    stories {
      US-006 "En tant que cinéphile du petit écran, je veux choisir les chaînes que je reçois,
              afin de ne pas être alerté pour des diffusions inaccessibles." {
        acceptance-criteria {
          AC-006-01 "Par défaut, les chaînes de la TNT gratuite sont sélectionnées"
          AC-006-02 "Je peux ajouter ou retirer des chaînes"
          AC-006-03 "Aucune alerte n'est envoyée pour une chaîne non sélectionnée"
        }
      }
    }
  }

  feature FEAT-005 "Agenda de mes films" {
    summary "Voir en un coup d'œil ce que je peux regarder parmi mes envies : ce soir, cette semaine,
             puis les prochaines diffusions connues"
    persona "Cinéphile du petit écran"
    value-proposition "Savoir quoi regarder ce soir parmi ses envies et planifier ses soirées cinéma
                       sans parcourir la grille"
    priority should
    status proposed
    addresses "Ne pas rater la diffusion d'un film attendu", "Savoir quoi regarder parmi mes envies, maintenant"
    advances "Adoption et rétention"
    stories {
      US-007 "En tant que cinéphile du petit écran, je veux voir la liste des prochaines diffusions
              de mes films sous radar, afin de planifier mes soirées." {
        acceptance-criteria {
          AC-007-01 "L'agenda liste les diffusions à venir triées par date"
          AC-007-02 "Seules les chaînes que je reçois apparaissent"
        }
      }
      US-010 "En tant que cinéphile du petit écran, je veux voir en ouvrant l'application ceux de mes films
              « envie de voir » que je peux regarder ce soir, afin de choisir sans chercher au hasard." {
        acceptance-criteria {
          AC-010-01 "Une vue « Ce soir » liste mes envies diffusées aujourd'hui sur mes chaînes, triées par heure"
          AC-010-02 "Une vue « Cette semaine » liste mes envies diffusées dans les 7 prochains jours"
          AC-010-03 "Si aucune envie n'est diffusée ce soir, la vue l'indique et propose la prochaine diffusion connue"
          AC-010-04 "À partir de la R3, les vues incluent aussi mes envies disponibles sur mes plateformes"
        }
      }
    }
  }

  feature FEAT-006 "Suggestions à partir de mes films aimés" {
    summary "Proposer de marquer « envie de voir » des films proches de ceux que j'aime"
    persona "Cinéphile du petit écran"
    value-proposition "Donner de la valeur à la mention « j'aime » au-delà de la simple liste"
    priority could
    status proposed
    addresses "Garder la trace des films qui m'intéressent"
    advances "Adoption et rétention"
  }

  feature FEAT-007 "Programmer l'enregistrement sur la box" {
    summary "Depuis une alerte de diffusion, programmer l'enregistrement du film sur la box de l'utilisateur"
    persona "Cinéphile du petit écran"
    value-proposition "Passer de « je suis prévenu » à « le film est enregistré », même quand on n'est pas devant la télé"
    priority could
    status proposed
    addresses "Ne pas rater la diffusion d'un film attendu"
    advances "Adoption et rétention"
  }

  feature FEAT-008 "Radar par critère : cinéaste, acteur, genre" {
    summary "Mettre sous radar un cinéaste, un acteur ou un genre et être alerté dès qu'un film correspondant est programmé"
    persona "Cinéphile du petit écran"
    value-proposition "Être prévenu d'un film qu'on ne connaissait pas encore mais qui correspond à ses goûts
                       (« dès qu'un David Lynch passe », « dès qu'un film gore passe »)"
    priority could
    status proposed
    addresses "Être prévenu des films qui correspondent à mes goûts"
    advances "Adoption et rétention", "Pertinence des alertes"
  }

  feature FEAT-009 "Radar sur mes plateformes de streaming" {
    summary "Alerter quand un film sous radar, ou correspondant à un critère suivi, arrive sur une plateforme à laquelle je suis abonné"
    persona "Cinéphile du petit écran"
    value-proposition "Profiter aussi des abonnements déjà payés (Netflix, Prime Video…) sans surveiller leurs catalogues"
    priority could
    status proposed
    addresses "Ne pas rater la diffusion d'un film attendu", "Être prévenu des films qui correspondent à mes goûts"
    advances "Adoption et rétention", "Trafic qualifié vers les plateformes"
  }

  // ---------------------------------------------------------------------------
  // Hypothèses non validées, risques, contraintes, questions
  // ---------------------------------------------------------------------------

  assumption "Programmes TV accessibles" {
    statement "Il existe une source de programmes TV (EPG) pour les chaînes françaises, exploitable
               légalement et à un coût compatible avec le projet, publiée au moins 7 jours à l'avance"
    impact-if-wrong "Sans programmes, pas de radar : le produit perd sa raison d'être"
    validation-plan "Recenser les sources (flux XMLTV publics, API commerciales, données des chaînes)
                     et vérifier licence, coût, couverture et horizon"
    status unvalidated
    underpins "FEAT-003", "FEAT-004", "FEAT-005"
  }

  assumption "Programme rattachable à un film" {
    statement "On peut relier automatiquement une diffusion au bon film (titre, année, réalisateur) dans plus de 95 % des cas"
    impact-if-wrong "Alertes manquées ou erronées ; perte de confiance rapide"
    validation-plan "Tester le rapprochement sur 4 semaines de programmes de la TNT"
    status unvalidated
    underpins "FEAT-003"
  }

  assumption "Assez de films diffusés à la télé" {
    statement "Un utilisateur qui suit 5 à 10 films reçoit au moins une alerte par trimestre"
    impact-if-wrong "Trop peu d'alertes : l'utilisateur oublie l'application ou la désinstalle"
    validation-plan "Mesurer sur l'historique des programmes la fréquence de rediffusion d'un échantillon de 200 films"
    status unvalidated
    underpins "FEAT-003"
  }

  risk "Licence des programmes TV" {
    statement "La source de programmes choisie interdit l'usage commercial ou devient payante"
    likelihood medium
    impact critical
    mitigation mitigate
    owner "Anthony (porteur du produit)"
    threatens "FEAT-003", "Fiabilité du radar"
  }

  risk "Notifications coupées" {
    statement "L'utilisateur refuse ou coupe les notifications et ne reçoit plus les alertes"
    likelihood medium
    impact high
    mitigation mitigate
    owner "Anthony (porteur du produit)"
    threatens "Adoption et rétention"
  }

  risk "Lien de connexion non reçu" {
    statement "Le lien de connexion arrive en courrier indésirable ou trop tard, et l'utilisateur abandonne l'inscription"
    likelihood medium
    impact high
    mitigation mitigate
    owner "Anthony (porteur du produit)"
    threatens "Adoption et rétention"
  }

  risk "Perte de confiance par la mise en avant payante" {
    statement "Les utilisateurs perçoivent les résultats comme orientés par l'argent des plateformes
               et cessent de faire confiance aux recommandations de FilmRadar"
    likelihood medium
    impact high
    mitigation mitigate
    owner "Anthony (porteur du produit)"
    threatens "Trafic qualifié vers les plateformes"
  }

  assumption "Trafic suffisant pour intéresser les plateformes" {
    statement "FilmRadar peut générer assez de redirections vers chaque plateforme pour qu'elle accepte de les rémunérer"
    impact-if-wrong "Pas de monétisation par les plateformes : il faut un autre modèle économique"
    validation-plan "Mesurer les redirections pendant 6 mois et les comparer aux seuils des programmes d'affiliation des plateformes"
    status unvalidated
    underpins "FEAT-012"
  }

  constraint "Transparence du classement" {
    statement "Toute offre mise en avant contre rémunération est signalée comme telle à l'utilisateur,
               et les critères de classement des offres sont publics (Code de la consommation, art. L111-7)"
    source regulatory
    constrains "FEAT-012"
  }

  constraint "RGPD" {
    statement "Les données personnelles (compte, listes de films, chaînes reçues, abonnements déclarés,
               jeton d'accès à la box) sont traitées conformément au RGPD, y compris le droit à l'effacement"
    source regulatory
    constrains "FEAT-002", "FEAT-003", "FEAT-004", "FEAT-007", "FEAT-012", "FEAT-013"
  }

  constraint "Consentement à la mesure des redirections" {
    statement "La mesure des clics vers les plateformes, lorsqu'elle permet de suivre un utilisateur,
               nécessite son consentement préalable ; à défaut, elle reste anonyme et agrégée"
    source regulatory
    constrains "FEAT-012"
  }

  constraint "Consentement aux notifications" {
    statement "Les alertes par notification ou par e-mail nécessitent le consentement explicite de l'utilisateur"
    source regulatory
    constrains "FEAT-003"
  }

  open-question "Source des programmes TV" {
    question "Quelle source de programmes TV utiliser, avec quelle couverture et quel horizon ?"
    context "Conditionne tout le radar et le périmètre des chaînes couvertes"
    owner "Anthony (porteur du produit)"
    deadline 2026-12-15
    status open
    blocks "FEAT-003", "FEAT-004"
  }

  open-question "Canal d'alerte" {
    question "Les alertes passent-elles par notification mobile, par e-mail, ou les deux ?"
    context "Détermine s'il faut une application mobile dès la V1 ou si une application web suffit"
    owner "Anthony (porteur du produit)"
    deadline 2026-12-15
    status open
    blocks "FEAT-003"
  }

  open-question "Source du catalogue de films" {
    question "Quel catalogue de films utiliser pour la recherche (titres français et originaux, affiches) ?"
    context "Conditionne la recherche et le rapprochement diffusion → film ; licence à vérifier"
    owner "Anthony (porteur du produit)"
    deadline 2026-12-15
    status open
    blocks "FEAT-001"
  }

  open-question "Chaînes couvertes en V1" {
    question "La V1 couvre-t-elle uniquement la TNT gratuite, ou aussi les chaînes du câble et du satellite ?"
    context "Plus de chaînes augmente la valeur mais aussi le coût des données et le bruit"
    owner "Anthony (porteur du produit)"
    deadline 2026-12-15
    status open
    blocks "FEAT-004"
  }

  open-question "Enregistrement à distance sur les box" {
    question "Comment obtenir de l'utilisateur l'autorisation (jeton d'accès) de piloter sa box, sans parcours trop lourd ni stockage risqué ?"
    context "La Freebox expose une API d'enregistrement : la faisabilité technique est acquise pour Free.
             La difficulté porte sur la capture de l'identité : l'utilisateur doit autoriser FilmRadar
             et fournir son jeton, que FilmRadar devra conserver de façon sûre.
             Reste à vérifier l'existence d'API équivalentes chez Orange, SFR et Bouygues"
    owner "Anthony (porteur du produit)"
    deadline 2027-06-30
    status open
    blocks "FEAT-007"
  }

  open-question "Connexion avec Apple" {
    question "Faut-il proposer la connexion avec Apple dès la R1 ?"
    context "Si FilmRadar est publié comme application iOS et propose la connexion Google, les règles
             de l'App Store imposent d'offrir aussi une option de connexion équivalente respectueuse
             de la vie privée, typiquement Apple. Dépend de la question « Canal d'alerte »
             (application mobile ou application web)"
    owner "Anthony (porteur du produit)"
    deadline 2026-12-15
    status open
    blocks "FEAT-013"
  }

  open-question "Granularité des critères" {
    question "Les données disponibles permettent-elles de reconnaître un cinéaste, un acteur et un genre fin
              (« gore » plutôt que simplement « horreur ») pour chaque film diffusé ?"
    context "Les catalogues de films classent souvent par grands genres ; les sous-genres comme le gore
             relèvent plutôt de mots-clés, moins fiables. Principe retenu : se baser sur les données
             de style trouvées, sans construire de classification propre. Conditionne la pertinence
             du radar par critère et de la recherche par style"
    owner "Anthony (porteur du produit)"
    deadline 2027-03-31
    status open
    blocks "FEAT-008", "FEAT-011"
  }

  open-question "Source des catalogues de streaming" {
    question "Quelle source fiable et utilisable légalement donne la disponibilité des films par plateforme en France ?"
    context "Nécessaire pour le radar streaming et « Où regarder ». Le catalogue d'une plateforme est le même
             pour tous les abonnés d'un pays : inutile de le lire compte par compte.
             Pistes : agrégateurs avec API (données de disponibilité JustWatch via TMDB, Streaming Availability,
             Watchmode…), à vérifier pour la licence commerciale, la couverture France et le coût ;
             à terme, flux fournis directement par les plateformes partenaires.
             La VOD des box est en général un service de VOD comme un autre, couvert comme les autres
             plateformes ; seul Free Ciné, propre à Free, demande une source spécifique.
             Écarté : explorer automatiquement les catalogues avec un compte abonné (interdit par les
             conditions d'utilisation des plateformes, fragile, et incompatible avec un partenariat futur)"
    owner "Anthony (porteur du produit)"
    deadline 2027-06-30
    status open
    blocks "FEAT-009", "FEAT-012"
  }

  // ---------------------------------------------------------------------------
  // Parcours
  // ---------------------------------------------------------------------------

  journey "Être prévenu qu'un film attendu passe à la télé" for "Cinéphile du petit écran" {
    trigger "Un ami lui conseille un film qu'il n'a pas vu"
    outcome "Il regarde le film à la télé le soir de sa diffusion"
    steps {
      step 1 {
        action "Cherche le film dans FilmRadar"
        system-response "Affiche les résultats avec affiche, année et réalisateur"
        channel app
        emotional-tone neutral
      }
      step 2 {
        action "Marque le film « envie de voir »"
        system-response "Confirme que le film est sous radar"
        channel app
        emotional-tone confident
      }
      step 3 {
        action "Oublie le film pendant plusieurs semaines"
        channel external
        emotional-tone neutral
      }
      step 4 {
        action "Reçoit une alerte : le film passe jeudi à 21h sur une chaîne qu'il reçoit"
        system-response "Envoie l'alerte avec film, chaîne, date et heure"
        channel app
        emotional-tone delighted
      }
      step 5 {
        action "Reçoit le rappel le jour même"
        system-response "Envoie le rappel de diffusion"
        channel app
        emotional-tone confident
      }
      step 6 {
        action "Regarde le film à la télé"
        channel external
        emotional-tone delighted
      }
    }
  }

  journey "Choisir un film ce soir parmi mes envies" for "Cinéphile du petit écran" {
    trigger "Il s'installe un soir devant l'écran sans savoir quoi regarder"
    outcome "Il regarde un film qu'il avait noté plusieurs semaines plus tôt"
    steps {
      step 1 {
        action "Ouvre la grille des programmes ou une plateforme et ne sait pas quoi chercher"
        channel external
        emotional-tone frustrated
      }
      step 2 {
        action "Ouvre FilmRadar"
        system-response "Affiche la vue « Ce soir » : ses envies diffusées aujourd'hui sur ses chaînes
                         et, à partir de la R3, disponibles sur ses plateformes"
        channel app
        emotional-tone neutral
      }
      step 3 {
        action "Retrouve un film conseillé par un ami et oublié depuis"
        system-response "Indique la chaîne et l'heure, ou la plateforme avec un lien direct"
        channel app
        emotional-tone delighted
      }
      step 4 {
        action "Regarde le film"
        channel external
        emotional-tone confident
      }
    }
  }

  // ---------------------------------------------------------------------------
  // Versions
  // ---------------------------------------------------------------------------

  release "R1 — Radar minimal" {
    target-date "T1 2027"
    theme "Chercher un film, le suivre, être prévenu de sa diffusion sur la TNT"
    status planned
    includes {
      "FEAT-001"
      "FEAT-002"
      "FEAT-003"
      "FEAT-013"
    }
    entry-criteria {
      "Source des programmes TV choisie et licence validée"
      "Source du catalogue de films choisie"
    }
    exit-criteria {
      "Toutes les fonctionnalités must passent leurs critères d'acceptation"
      "Rapprochement diffusion → film correct dans plus de 95 % des cas sur 4 semaines de test"
      "Bêta fermée lancée avec au moins 30 utilisateurs"
    }
  }

  release "R2 — Alertes ciblées" {
    target-date "T2 2027"
    theme "Alertes utiles, savoir quoi regarder ce soir et retrouver un film sans son titre"
    status planned
    depends-on "R1 — Radar minimal"
    includes {
      "FEAT-004"
      "FEAT-005"
      "FEAT-010"
    }
    exit-criteria {
      "Moins de 2 % d'alertes signalées comme erronées"
    }
  }

  release "R3 — De l'envie au visionnage" {
    target-date "À définir"
    theme "Savoir où regarder chaque film (télé, streaming, VOD) et ne plus le rater, même absent"
    status planned
    depends-on "R2 — Alertes ciblées"
    includes {
      "FEAT-009"
      "FEAT-012"
      "FEAT-007"
    }
    entry-criteria {
      "Objectif « Adoption et rétention » atteint (≥ 40 % d'alertes actives à 3 mois)"
      "Source des catalogues de streaming choisie et licence validée"
    }
    exit-criteria {
      "Redirections vers les plateformes mesurées par plateforme"
      "Au moins 20 % des utilisateurs actifs cliquent sur une offre au moins une fois par mois (cible à confirmer)"
      "Critères de classement des offres publiés et offres rémunérées signalées"
    }
  }

  release "R4 — Suivre ses goûts" {
    target-date "À définir"
    theme "Être prévenu et retrouver des films par critère, style et proximité avec ses films aimés"
    status planned
    depends-on "R2 — Alertes ciblées"
    includes {
      "FEAT-008"
      "FEAT-011"
      "FEAT-006"
    }
    entry-criteria {
      "Question « Granularité des critères » résolue"
    }
    exit-criteria {
      "Moins de 2 % d'alertes hors sujet signalées sur le radar par critère"
    }
  }
}
